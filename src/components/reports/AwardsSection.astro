---
// 시상 섹션 컴포넌트
interface Award {
  category: string;
  name: string;
  generation: string;
  score: string;
  color: string;
}

interface Props {
  awards: Award[];
}

const { awards } = Astro.props;
---

<section class="mb-20">
  <div class="text-center mb-12">
    <h2 class="text-3xl font-black text-gray-900 sm:text-4xl">
      🏆 <span class="bg-gradient-to-r from-yellow-600 to-orange-600 bg-clip-text text-transparent">시상 내역</span>
    </h2>
    <p class="mt-4 text-lg text-gray-600">이번 모임의 영예의 주인공들</p>
  </div>
  
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {awards.map((award, index) => (
      <div class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
        <div class={`absolute inset-0 bg-gradient-to-br ${award.color} opacity-0 group-hover:opacity-10 transition-opacity duration-500`}></div>
        <div class="relative">
          <div class="flex items-center justify-between mb-4">
            <div class="text-4xl">🏆</div>
            <div class={`px-3 py-1 rounded-full bg-gradient-to-r ${award.color} text-white text-xs font-bold`}>
              #{index + 1}
            </div>
          </div>
          <h3 class="font-bold text-gray-800 mb-3 text-sm leading-tight">{award.category}</h3>
          <div class="space-y-1">
            <p class="text-xl font-black text-gray-900">{award.name}</p>
            <p class="text-sm text-gray-500">{award.generation}</p>
            <div class={`inline-block px-3 py-1 rounded-lg bg-gradient-to-r ${award.color} text-white font-bold text-sm mt-2`}>
              {award.score}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
