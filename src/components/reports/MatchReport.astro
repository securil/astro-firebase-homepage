---
// 경기 리포트 컴포넌트
export interface Props {
  matchReport: {
    headline: string;
    subheadline: string;
    stories: Array<{
      type: string;
      icon: string;
      title: string;
      content: string;
      highlight: string;
    }>;
    stats: Array<{
      label: string;
      value: string;
      detail: string;
    }>;
  };
}

const { matchReport } = Astro.props;
---

<section class="mb-20">
  <div class="text-center mb-12">
    <h2 class="text-3xl font-black text-gray-900 sm:text-4xl">
      📰 <span class="bg-gradient-to-r from-red-600 to-orange-600 bg-clip-text text-transparent">경기 리포트</span>
    </h2>
    <p class="mt-4 text-lg text-gray-600">스포츠 중계석에서 전하는 생생한 경기 분석</p>
  </div>

  <!-- 헤드라인 섹션 -->
  <div class="bg-gradient-to-r from-red-50 to-orange-50 rounded-2xl p-8 mb-8 border border-red-200 shadow-xl">
    <div class="text-center">
      <h3 class="text-2xl font-black text-red-800 mb-3">
        🚨 {matchReport.headline}
      </h3>
      <p class="text-lg text-red-700 font-medium">
        {matchReport.subheadline}
      </p>
    </div>
  </div>

  <!-- 스토리 섹션 -->
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-8">
    {matchReport.stories.map((story) => (
      <div class={`bg-white rounded-2xl p-6 shadow-lg border hover:shadow-xl transition-all duration-300 hover:-translate-y-1 ${
        story.type === 'winner' ? 'border-yellow-200 bg-gradient-to-br from-yellow-50 to-orange-50' :
        story.type === 'runner-up' ? 'border-gray-200 bg-gradient-to-br from-gray-50 to-slate-50' :
        story.type === 'course-masters' ? 'border-green-200 bg-gradient-to-br from-green-50 to-emerald-50' :
        story.type === 'course-analysis' ? 'border-blue-200 bg-gradient-to-br from-blue-50 to-indigo-50' :
        'border-purple-200 bg-gradient-to-br from-purple-50 to-pink-50'
      }`}>
        <div class="flex items-center mb-4">
          <span class="text-3xl mr-3">{story.icon}</span>
          <h4 class={`font-bold text-lg ${
            story.type === 'winner' ? 'text-yellow-800' :
            story.type === 'runner-up' ? 'text-gray-800' :
            story.type === 'course-masters' ? 'text-green-800' :
            story.type === 'course-analysis' ? 'text-blue-800' :
            'text-purple-800'
          }`}>{story.title}</h4>
        </div>
        
        <p class="text-gray-700 leading-relaxed mb-4 text-sm">
          {story.content}
        </p>
        
        <div class={`inline-block px-3 py-1 rounded-full text-xs font-bold ${
          story.type === 'winner' ? 'bg-yellow-200 text-yellow-800' :
          story.type === 'runner-up' ? 'bg-gray-200 text-gray-800' :
          story.type === 'course-masters' ? 'bg-green-200 text-green-800' :
          story.type === 'course-analysis' ? 'bg-blue-200 text-blue-800' :
          'bg-purple-200 text-purple-800'
        }`}>
          🎯 {story.highlight}
        </div>
      </div>
    ))}
  </div>

  <!-- 통계 요약 -->
  <div class="bg-gradient-to-r from-slate-800 to-gray-900 rounded-2xl p-8 text-white">
    <h4 class="text-xl font-bold mb-6 text-center flex items-center justify-center">
      <span class="text-2xl mr-3">📊</span>
      경기 하이라이트 
    </h4>
    
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      {matchReport.stats.map((stat) => (
        <div class="text-center">
          <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
            <p class="text-gray-300 text-sm mb-2">{stat.label}</p>
            <p class="font-black text-xl text-white mb-1">{stat.value}</p>
            <p class="text-gray-400 text-xs">{stat.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
