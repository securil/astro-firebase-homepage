---
// 코스별 분석 섹션 컴포넌트
interface TopPlayer {
  name: string;
  score: number;
  generation: string;
}

interface CourseStats {
  name: string;
  players: number;
  topPlayers: TopPlayer[];
}

interface Props {
  courseStats: CourseStats[];
}

const { courseStats } = Astro.props;
---

<section class="mb-20">
  <div class="text-center mb-12">
    <h2 class="text-3xl font-black text-gray-900 sm:text-4xl">
      🏔️ <span class="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent">코스별 분석</span>
    </h2>
    <p class="mt-4 text-lg text-gray-600">각 코스별 상위 3위 기록</p>
  </div>
  
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {courseStats?.map((course, index) => (
      <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100">
        <div class="flex items-start justify-between mb-4">
          <h3 class="font-bold text-gray-800 text-lg leading-tight">{course.name}</h3>
          <div class="text-2xl">
            {index === 0 ? '🏔️' : index === 1 ? '🗻' : index === 2 ? '⛰️' : '🏕️'}
          </div>
        </div>
        
        <div class="space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-600">참가자</span>
            <span class="font-bold text-blue-600">{course.players}명</span>
          </div>
          
          <div class="border-t pt-3">
            <h4 class="text-sm font-bold text-gray-700 mb-3">🏆 상위 3위</h4>
            <div class="space-y-2">
              {course.topPlayers?.map((player, playerIndex) => (
                <div class="flex justify-between items-center">
                  <div class="flex items-center">
                    <span class={`inline-flex items-center justify-center w-5 h-5 rounded-full text-xs font-bold mr-2 ${
                      playerIndex === 0 ? 'bg-yellow-400 text-white' :
                      playerIndex === 1 ? 'bg-gray-300 text-white' :
                      'bg-orange-400 text-white'
                    }`}>
                      {playerIndex + 1}
                    </span>
                    <div>
                      <div class="text-sm font-medium text-gray-800">{player.name}</div>
                      <div class="text-xs text-gray-500">{player.generation}</div>
                    </div>
                  </div>
                  <span class="font-bold text-emerald-600">{player.score}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
