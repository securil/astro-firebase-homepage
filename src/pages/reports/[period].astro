---
export async function getStaticPaths() {
  return [
    { params: { period: '2025-03' } },
    { params: { period: '2025-05' } },
    { params: { period: '2025-06' } }
  ];
}

import MainLayout from '../../layouts/MainLayout.astro';
import ReportHero from '../../components/reports/ReportHero.astro';
import AwardsSection from '../../components/reports/AwardsSection.astro';
import CourseStatsSection from '../../components/reports/CourseStatsSection.astro';
import MatchReport from '../../components/reports/MatchReport.astro';
import StatsSection from '../../components/reports/StatsSection.astro';
import GallerySlider from '../../components/ui/GallerySlider.jsx';
import ResponsiveScoreTable from '../../components/ui/ResponsiveScoreTable.jsx';
import { getReportData, calculateScoreDistribution, defaultReportData } from '../../data/reports/reportData.js';

const { period } = Astro.params;
const [year, month] = period.split('-');

// 데이터 로드
const data = getReportData(period) || defaultReportData;

// 타수 분포 계산
const scoreDistribution = data.scores ? calculateScoreDistribution(data.scores) : [];
---

<MainLayout title={`${data.title} - 청구회`} currentPage="reports">
  <div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50">
    
    <!-- Hero Banner -->
    <ReportHero 
      title={data.title}
      date={data.date}
      location={data.location}
      participants={data.participants}
      weather={data.weather}
      temperature={data.temperature}
    />

    {data.participants > 0 ? (
      <div class="px-6 py-16 mx-auto max-w-7xl">
        
        <!-- 시상 내역 -->
        {data.awards && data.awards.length > 0 && (
          <AwardsSection awards={data.awards} />
        )}

        <!-- 조편성표 (5월 대회형) -->
        {(period === '2025-05' && data.teamList) && (
          <section class="mb-20">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-black text-gray-900 sm:text-4xl">
                🎯 <span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">청구회장배 조편성표</span>
              </h2>
              <p class="mt-4 text-lg text-gray-600">2025년 5월 27일 대회 조편성 및 정보</p>
            </div>

            <!-- 시상 리스트 -->
            <div class="mb-8 bg-gradient-to-r from-yellow-50 to-orange-50 rounded-2xl p-6 shadow-lg border border-yellow-200">
              <h3 class="text-xl font-bold mb-4 text-center text-orange-800">🏆 시상 리스트</h3>
              <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
                {data.teamList.prizes?.map((prize) => (
                  <div class="bg-white rounded-lg p-3 shadow-sm border border-orange-100">
                    <p class="text-sm font-medium text-gray-700">• {prize}</p>
                  </div>
                ))}
              </div>
            </div>

            <!-- 대회 진표 -->
            <div class="mb-8 bg-gradient-to-r from-green-50 to-emerald-50 rounded-2xl p-6 shadow-lg border border-green-200">
              <h3 class="text-xl font-bold mb-4 text-center text-emerald-800">📊 대회 진표</h3>
              <div class="grid gap-4 md:grid-cols-3">
                {data.teamList.division?.map((div) => (
                  <div class="bg-white rounded-lg p-4 shadow-sm border border-emerald-100 text-center">
                    <h4 class="font-bold text-gray-800 mb-2">{div.name}</h4>
                    <p class="text-sm text-gray-600">{div.teams}팀 ({div.players}명)</p>
                  </div>
                ))}
              </div>
              {data.teamList.totalInfo && (
                <div class="mt-4 text-center bg-white rounded-lg p-3 shadow-sm border border-emerald-100">
                  <p class="font-bold text-emerald-800">총 {data.teamList.totalInfo.totalPlayers}명, {data.teamList.totalInfo.totalTeams}조</p>
                  <p class="text-sm text-gray-600 mt-1">{data.teamList.totalInfo.startTime} ({data.teamList.totalInfo.duration})</p>
                </div>
              )}
            </div>
          </section>
        )}

        <!-- 조편성표 (3월, 6월 월례회형) -->
        {((period === '2025-03' || period === '2025-06') && data.teamList) && (
          <section class="mb-20">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-black text-gray-900 sm:text-4xl">
                📋 <span class="bg-gradient-to-r from-green-600 to-blue-600 bg-clip-text text-transparent">조편성표</span>
              </h2>
              <p class="mt-4 text-lg text-gray-600">{data.teamList.title}</p>
            </div>

            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 p-6">
                <!-- 왼쪽 영역 -->
                <div class="space-y-6">
                  {data.teamList.courses?.map((course) => (
                    <div class="border border-gray-200 rounded-lg overflow-hidden">
                      <div class="bg-gradient-to-r from-blue-500 to-blue-600 text-white p-3 text-center">
                        <h3 class="font-bold">{course.name} ({course.startTime})</h3>
                      </div>
                      <div class="divide-y divide-gray-200">
                        {course.teams?.map((team) => (
                          <div class="p-3 hover:bg-gray-50">
                            <div class="flex items-center mb-2">
                              <span class="font-bold text-gray-800 mr-2">{team.number}조({team.time})</span>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                              {team.players?.map((player) => (
                                <span class="text-sm text-gray-600 bg-gray-100 px-2 py-1 rounded">
                                  {player}
                                </span>
                              ))}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>

                <!-- 오른쪽 영역 -->
                <div class="space-y-6">
                  {data.teamList.rightSide && (
                    <div class="border border-gray-200 rounded-lg overflow-hidden">
                      <div class="bg-gradient-to-r from-purple-500 to-purple-600 text-white p-3 text-center">
                        <h3 class="font-bold">{data.teamList.rightSide.name} ({data.teamList.rightSide.startTime})</h3>
                      </div>
                      <div class="divide-y divide-gray-200">
                        {data.teamList.rightSide.teams?.map((team) => (
                          <div class="p-3 hover:bg-gray-50">
                            <div class="flex items-center mb-2">
                              <span class="font-bold text-gray-800 mr-2">{team.number}조({team.time})</span>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                              {team.players?.map((player) => (
                                <span class="text-sm text-gray-600 bg-gray-100 px-2 py-1 rounded">
                                  {player}
                                </span>
                              ))}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {data.teamList.rightSideExtended && (
                    <div class="border border-gray-200 rounded-lg overflow-hidden">
                      <div class="bg-gradient-to-r from-green-500 to-green-600 text-white p-3 text-center">
                        <h3 class="font-bold">{data.teamList.rightSideExtended.name} ({data.teamList.rightSideExtended.startTime})</h3>
                      </div>
                      <div class="divide-y divide-gray-200">
                        {data.teamList.rightSideExtended.teams?.map((team) => (
                          <div class="p-3 hover:bg-gray-50">
                            <div class="flex items-center mb-2">
                              <span class="font-bold text-gray-800 mr-2">{team.number}조({team.time})</span>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                              {team.players?.map((player) => (
                                <span class="text-sm text-gray-600 bg-gray-100 px-2 py-1 rounded">
                                  {player}
                                </span>
                              ))}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- 코스별 분석 -->
        {data.courseStats && data.courseStats.length > 0 && (
          <CourseStatsSection courseStats={data.courseStats} />
        )}

        <!-- 경기 리포트 (6월만) -->
        {period === '2025-06' && data.matchReport && (
          <MatchReport matchReport={data.matchReport} />
        )}

        <!-- 전체 성적표 -->
        {data.scores && data.scores.length > 0 && (
          <section class="mb-20">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-black text-gray-900 sm:text-4xl">
                📊 <span class="bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">전체 성적표</span>
              </h2>
              <p class="mt-4 text-lg text-gray-600">순위별 상세 결과</p>
            </div>
            
            <ResponsiveScoreTable 
              scores={data.scores}
              title="전체 성적표"
              client:load
            />
          </section>
        )}

        <!-- 여성 성적표 -->
        {data.femaleScores && data.femaleScores.length > 0 && (
          <section class="mb-20">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-black text-gray-900 sm:text-4xl">
                🌸 <span class="bg-gradient-to-r from-pink-600 to-rose-600 bg-clip-text text-transparent">여성 성적표</span>
              </h2>
              <p class="mt-4 text-lg text-gray-600">여성 참가자 상위 순위</p>
            </div>
            
            <ResponsiveScoreTable 
              scores={data.femaleScores}
              title="여성 성적표"
              isPinkTheme={true}
              client:load
            />
          </section>
        )}

        <!-- 통계 대시보드 -->
        <StatsSection 
          bestScore={data.bestScore}
          avgScore={data.avgScore}
          underPar={data.underPar}
          eighties={data.eighties}
        />

        <!-- 성과 분석 -->
        {data.scores && data.scores.length > 0 && (
          <section class="mb-20">
            <div class="bg-white rounded-2xl p-8 shadow-xl border border-gray-100">
              <h2 class="text-2xl font-black text-gray-900 mb-8 text-center">
                ✨ <span class="bg-gradient-to-r from-orange-600 to-red-600 bg-clip-text text-transparent">성과 분석</span>
              </h2>
              
              <div class="grid gap-8 md:grid-cols-2">
                <div class="space-y-6">
                  <div>
                    <h3 class="font-bold text-gray-800 mb-4 flex items-center">
                      <span class="text-2xl mr-3">🏆</span>
                      TOP 3 우수 성적자
                    </h3>
                    <div class="space-y-3">
                      {data.scores.slice(0, 3).map((player, index) => (
                        <div class={`flex items-center justify-between p-4 rounded-xl border ${
                          index === 0 ? 'bg-gradient-to-r from-yellow-50 to-orange-50 border-yellow-200' :
                          index === 1 ? 'bg-gradient-to-r from-gray-50 to-slate-50 border-gray-200' :
                          'bg-gradient-to-r from-orange-50 to-yellow-50 border-orange-200'
                        }`}>
                          <div class="flex items-center">
                            <span class="text-2xl mr-3">
                              {index === 0 ? '🥇' : index === 1 ? '🥈' : '🥉'}
                            </span>
                            <div>
                              <div class="font-bold text-gray-800">{player.name}</div>
                              <div class="text-sm text-gray-600">{player.generation}</div>
                            </div>
                          </div>
                          <div class={`text-2xl font-black ${
                            index === 0 ? 'text-yellow-600' :
                            index === 1 ? 'text-gray-600' :
                            'text-orange-600'
                          }`}>{player.score}타</div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
                
                <div class="space-y-6">
                  <div>
                    <h3 class="font-bold text-gray-800 mb-4 flex items-center">
                      <span class="text-2xl mr-3">📊</span>
                      타수 분포 분석
                    </h3>
                    <div class="space-y-3">
                      {scoreDistribution.map((dist) => (
                        <div class={`flex items-center justify-between p-3 rounded-lg border ${
                          dist.color === 'blue' ? 'bg-blue-50 border-blue-200' :
                          dist.color === 'emerald' ? 'bg-emerald-50 border-emerald-200' :
                          dist.color === 'yellow' ? 'bg-yellow-50 border-yellow-200' :
                          'bg-red-50 border-red-200'
                        }`}>
                          <span class={`font-medium ${
                            dist.color === 'blue' ? 'text-blue-700' :
                            dist.color === 'emerald' ? 'text-emerald-700' :
                            dist.color === 'yellow' ? 'text-yellow-700' :
                            'text-red-700'
                          }`}>{dist.range}</span>
                          <div class="flex items-center">
                            <div class={`w-20 rounded-full h-2 mr-3 ${
                              dist.color === 'blue' ? 'bg-blue-200' :
                              dist.color === 'emerald' ? 'bg-emerald-200' :
                              dist.color === 'yellow' ? 'bg-yellow-200' :
                              'bg-red-200'
                            }`}>
                              <div class={`h-2 rounded-full ${
                                dist.color === 'blue' ? 'bg-blue-600' :
                                dist.color === 'emerald' ? 'bg-emerald-600' :
                                dist.color === 'yellow' ? 'bg-yellow-600' :
                                'bg-red-600'
                              }`} style={`width: ${dist.percentage}%`}></div>
                            </div>
                            <span class={`font-bold ${
                              dist.color === 'blue' ? 'text-blue-800' :
                              dist.color === 'emerald' ? 'text-emerald-800' :
                              dist.color === 'yellow' ? 'text-yellow-800' :
                              'text-red-800'
                            }`}>{dist.count}명 ({dist.percentage}%)</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- 갤러리 섹션 -->
        {data.gallery && data.gallery.length > 0 && (
          <section class="px-6 py-16 mx-auto max-w-7xl">
            <div class="bg-white rounded-2xl p-8 shadow-xl">
              <GallerySlider 
                images={data.gallery}
                title="모임 갤러리"
                useFirebase={false}
                period={period}
                baseUrl={`${import.meta.env.BASE_URL}images/reports/${period}/gallery/`}
                client:load
              />
            </div>
          </section>
        )}

        <!-- 뒤로가기 -->
        <div class="text-center">
          <a 
            href={`${import.meta.env.BASE_URL}reports`}
            class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-gray-800 to-gray-900 hover:from-gray-900 hover:to-black text-white rounded-2xl transition-all duration-300 font-bold text-lg shadow-xl hover:shadow-2xl hover:-translate-y-1"
          >
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            리포트 목록으로 돌아가기
          </a>
        </div>
      </div>
    ) : (
      <div class="px-6 py-32 mx-auto max-w-4xl text-center">
        <div class="bg-white rounded-2xl p-12 shadow-xl">
          <div class="text-6xl mb-6">📊</div>
          <h2 class="text-3xl font-black text-gray-800 mb-4">모임 데이터 준비 중</h2>
          <p class="text-lg text-gray-600 mb-8">해당 기간의 모임 정보가 아직 업데이트되지 않았습니다.</p>
          <a 
            href={`${import.meta.env.BASE_URL}reports`}
            class="inline-block bg-gradient-to-r from-emerald-600 to-teal-600 text-white py-3 px-8 rounded-xl hover:from-emerald-700 hover:to-teal-700 transition-all duration-300 font-bold shadow-lg"
          >
            리포트 목록으로
          </a>
        </div>
      </div>
    )}
  </div>
</MainLayout>
