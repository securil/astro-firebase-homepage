---
// src/pages/reports.astro
import MainLayout from '../layouts/MainLayout.astro';
import Banner from '../components/Banner.astro';

const availableReports = [
  {
    period: '2025-03',
    title: '2025년 3월 정기모임',
    date: '2025-03-15',
    location: '이천 뉴스프링빌 CC',
    description: '봄맞이 정기모임 결과 및 시상내역'
  },
  {
    period: '2025-05',
    title: '2025년 5월 정기모임', 
    date: '2025-05-17',
    location: '이천 뉴스프링빌 CC',
    description: '5월 정기모임 결과 및 시상내역'
  },
  {
    period: '2025-06',
    title: '2025년 6월 정기모임',
    date: '2025-06-24',
    location: '이천 뉴스프링빌 CC',
    description: '412회 청구회 결과 및 시상내역'
  }
];
---

<MainLayout title="월별 리포트 - 청구회" currentPage="reports">
  <Banner 
    title="월별 리포트"
    subtitle="정기모임 결과 및 시상내역을 확인하세요"
    bgImage="images/stats-banner.jpg"
  />

  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">
          모임별 상세 리포트
        </h2>
        
        <div class="grid gap-6 md:grid-cols-2">
          {availableReports.map(report => (
            <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow p-6">
              <div class="flex justify-between items-start mb-4">
                <h3 class="text-xl font-semibold text-gray-800">{report.title}</h3>
                <span class="bg-primary text-white px-3 py-1 rounded-full text-sm">
                  {report.period.replace('-', '년 ').replace('-', '월')}
                </span>
              </div>
              
              <div class="space-y-2 mb-4 text-gray-600">
                <p><span class="font-medium">일자:</span> {report.date}</p>
                <p><span class="font-medium">장소:</span> {report.location}</p>
                <p class="text-sm">{report.description}</p>
              </div>
              
              <a 
                href={`${import.meta.env.BASE_URL}reports/${report.period}`}
                class="inline-block w-full text-center bg-gradient-to-r from-primary to-secondary text-white py-2 px-4 rounded-md font-medium hover:-translate-y-1 transition-transform"
              >
                상세 보기
              </a>
            </div>
          ))}
        </div>
        
        <div class="text-center mt-12">
          <p class="text-gray-600">
            * 4월 모임은 우천으로 인해 취소되었습니다.
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
