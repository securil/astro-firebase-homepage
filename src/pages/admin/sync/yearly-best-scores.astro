---
// src/pages/admin/sync/yearly-best-scores.astro
import MainLayout from '../../../layouts/MainLayout.astro';
---

<MainLayout title="연도별 베스트 스코어 동기화 - 청구회 골프모임" description="연도별 베스트 스코어 데이터 동기화" currentPage="admin">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl font-bold text-gray-800 mb-8">연도별 베스트 스코어 데이터 동기화</h1>
      
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h2 class="text-xl font-semibold mb-4">데이터 동기화 도구</h2>
        <p class="text-gray-600 mb-4">
          Meeting_Awards 컬렉션의 메달리스트 데이터를 기반으로 연도별 베스트 스코어를 추출하여 
          yearly_best_scores 컬렉션에 동기화합니다.
        </p>
        
        <div class="space-y-4">
          <button 
            id="sync-button"
            class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors"
          >
            데이터 동기화 실행
          </button>
          
          <button 
            id="view-data-button"
            class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium transition-colors ml-4"
          >
            현재 데이터 조회
          </button>
        </div>
        
        <div id="sync-status" class="mt-4 p-4 rounded-lg hidden">
          <div id="sync-message"></div>
        </div>
      </div>
      
      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold mb-4">연도별 베스트 스코어 현황</h2>
        <div id="yearly-best-data" class="overflow-x-auto">
          <p class="text-gray-500">데이터를 조회하려면 '현재 데이터 조회' 버튼을 클릭하세요.</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { syncYearlyBestScoresToCollection, getYearlyBestScoresFromCollection } from '../../../lib/service/stats-util.js';
    
    document.addEventListener('DOMContentLoaded', function() {
      const syncButton = document.getElementById('sync-button');
      const viewDataButton = document.getElementById('view-data-button');
      const syncStatus = document.getElementById('sync-status');
      const syncMessage = document.getElementById('sync-message');
      const yearlyBestData = document.getElementById('yearly-best-data');
      
      // 상태 메시지 표시 함수
      function showStatus(message, type = 'info') {
        syncStatus.className = `mt-4 p-4 rounded-lg ${
          type === 'success' ? 'bg-green-100 text-green-800' :
          type === 'error' ? 'bg-red-100 text-red-800' :
          'bg-blue-100 text-blue-800'
        }`;
        syncMessage.textContent = message;
        syncStatus.classList.remove('hidden');
      }
      
      // 데이터 동기화 실행
      syncButton.addEventListener('click', async function() {
        try {
          syncButton.disabled = true;
          syncButton.textContent = '동기화 중...';
          showStatus('데이터 동기화를 시작합니다...', 'info');
          
          const result = await syncYearlyBestScoresToCollection();
          
          if (result && result.length > 0) {
            showStatus(`동기화 완료! ${result.length}개의 연도별 베스트 스코어가 업데이트되었습니다.`, 'success');
            // 자동으로 데이터 새로고침
            await viewCurrentData();
          } else {
            showStatus('동기화할 데이터가 없습니다.', 'error');
          }
        } catch (error) {
          console.error('동기화 실패:', error);
          showStatus(`동기화 실패: ${error.message}`, 'error');
        } finally {
          syncButton.disabled = false;
          syncButton.textContent = '데이터 동기화 실행';
        }
      });
      
      // 현재 데이터 조회 함수
      async function viewCurrentData() {
        try {
          viewDataButton.disabled = true;
          viewDataButton.textContent = '조회 중...';
          
          const yearlyBestScores = await getYearlyBestScoresFromCollection();
          
          if (yearlyBestScores && yearlyBestScores.length > 0) {
            const tableHTML = `
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">연도</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">베스트 스코어</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">회원명</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">기수</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">모임ID</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  ${yearlyBestScores.map((item, index) => `
                    <tr class="${index % 2 === 0 ? 'bg-white' : 'bg-gray-50'}">
                      <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${item.year}</td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${item.score}</td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${item.memberName}</td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${item.generation}</td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${item.meetingId}</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            `;
            yearlyBestData.innerHTML = tableHTML;
            showStatus(`${yearlyBestScores.length}개의 연도별 베스트 스코어 데이터를 조회했습니다.`, 'success');
          } else {
            yearlyBestData.innerHTML = '<p class="text-gray-500">연도별 베스트 스코어 데이터가 없습니다.</p>';
            showStatus('데이터가 없습니다. 동기화를 실행해주세요.', 'error');
          }
        } catch (error) {
          console.error('데이터 조회 실패:', error);
          showStatus(`데이터 조회 실패: ${error.message}`, 'error');
        } finally {
          viewDataButton.disabled = false;
          viewDataButton.textContent = '현재 데이터 조회';
        }
      }
      
      // 현재 데이터 조회 버튼 이벤트
      viewDataButton.addEventListener('click', viewCurrentData);
    });
  </script>
</MainLayout>
